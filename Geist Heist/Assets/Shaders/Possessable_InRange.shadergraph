{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9dd0ad1162bb4fe99ef8ff979c00d2b9",
    "m_Title": "Note to self",
    "m_Content": "Keeping this here for later in case I figure it out.\n\nOutline shader only works on fully smoothed meshes (no forced hard edges through normals)\n\nThis means objects with the outline will NEED to be slightly higher poly to not cause lighting problems (edges we want to appear sharp with lighting will need to instead be beveled through topology instead of just through the normals, making all outlined objects need to be higher poly than would normally be intended.)\n\nThis subgraph is intended to fix this issue by smoothing the normal vectors and then making the outline from said smoothed normals, but it currently doesn't work right and I'm unsure as to why.\n\n-Madison",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1142.0,
        "y": -962.6666259765625,
        "width": 298.6666259765625,
        "height": 309.33331298828127
    },
    "m_Group": {
        "m_Id": ""
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.BlockNode",
    "m_ObjectId": "a08fc6509c8e42f78742685604a37f77",
    "m_Group": {
