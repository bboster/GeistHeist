  thisLevel: 1
--- !u!114 &2934618208113897100
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7148221544204128209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8fcdce510928fb4ab2354602fe37dcf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PADialogueUITrigger
  dialogueText:
  - BodyText: "ONE more piece, we have ONE MORE ARTIFACT, do you understand me!?
      How can we even call ourselves a museum with ONE INTERESTING ARTIFACT?! I swear,
      are any of you ACTUALLY doing your jobs?? \u2026 What?? What do you mean it\u2019s
      still record-"
    dialogueSpeaker: 0
    SecondsDelayUntilNextDialogue: 15
    StayLength: 15
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 0
  - BodyText: "Oh goodness, will there ever be an end to this awful woman's yakking?
      Does she not realize I\u2019m simply reclaiming what is rightfully mine?"
    dialogueSpeaker: 1
    SecondsDelayUntilNextDialogue: 10
    StayLength: 10
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 1
  AlwaysAppear: 0
  chanceToAppear: 1
  requiredScenesCompleted:
  - FINAL Parlour Room
  - Exhibit 1 Wing 2 - Library
  - KitchenWing1
  - Exibit 2 Wing 2
  requiredScenesNotCompleted:
  - Wing 3 - Bedroom Greybox
  requiredCollectables: 
  requiredCollectablesUncollected: 
