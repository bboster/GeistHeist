--- !u!114 &874999385754937035
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7148221544204128209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8fcdce510928fb4ab2354602fe37dcf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PADialogueUITrigger
  dialogueText:
  - BodyText: Welcome, wonderful guests, to the illustrious Hubert Museum!
    dialogueSpeaker: 0
    SecondsDelayUntilNextDialogue: 4
    StayLength: 4
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 0
  - BodyText: Who on EARTH could that be!? Reveal yourself, fiend!
    dialogueSpeaker: 1
    SecondsDelayUntilNextDialogue: 4
    StayLength: 4
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 1
  - BodyText: This museum has been constructed over the past few years to commemorate
      the legacy of the late Oliver O. Hubert, or, as his FEW friends liked to call
      him, Ollie! Feel free to explore the Lobby or the newly opened Parlor exhibit,
      featuring the acclaimed Rococo Vase, the very beginning of Hubert's collection!
    dialogueSpeaker: 0
    SecondsDelayUntilNextDialogue: 11
    StayLength: 11
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 2
  - BodyText: Come back tomorrow to explore the Upper Wing of the Library Exhibit,
      The Gallery. Have a wonderful day, everyone! This has been a prerecorded message.
    dialogueSpeaker: 0
    SecondsDelayUntilNextDialogue: 7
    StayLength: 7
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 3
  - BodyText: '"Prerecorded?" I beg your pardon? That nogoodnik has some nerve bewildering
      me in my own home! *sigh* No matter... I must investigate this... "parlor exhibit."'
    dialogueSpeaker: 1
    SecondsDelayUntilNextDialogue: 10
    StayLength: 10
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 4
  AlwaysAppear: 0
  chanceToAppear: 1
  requiredScenesCompleted: []
  requiredScenesNotCompleted:
  - FINAL Parlour Room
  - Wing 3 - Bedroom Greybox
  - Exibit 2 Wing 2
  - Exhibit 1 Wing 2 - Library
  - KitchenWing1
  requiredCollectables: 
  requiredCollectablesUncollected: 
  RequireSpecificHat: 0
  requiredHat: 0
  useOldAudioSystem: 0
  audioEventReference:
    Guid:
      Data1: 811132438
      Data2: 1225705089
      Data3: -1825269349
      Data4: -41913075
    Path: event:/Voicelines/VLLobbyNightOne
  AudioParameterName: VLLobbyNightOne
  Text: 
  stayLength: 0
  whichLine: 0
  thisLevel: 1
--- !u!114 &9024013404956872322
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7148221544204128209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8fcdce510928fb4ab2354602fe37dcf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PADialogueUITrigger
  dialogueText:
  - BodyText: Welcome, wonderful guests, to the Illustrious Hubert Museum! We're
      proud to announce that we've opened the gallery exhibit upstairs! Explore and
      admire Oliver O. Hubert's vast collection to your heart's content.
    dialogueSpeaker: 0
    SecondsDelayUntilNextDialogue: 8
    StayLength: 8
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 0
  - BodyText: As a small side note, one of our artifacts went missing last night.
      If you happen to know its whereabouts, please report it to the staff. And if
      you were the individual who took it... How about we keep our hands to ourselves
      next time, mmkay? This has been a prerecorded message!
    dialogueSpeaker: 0
    SecondsDelayUntilNextDialogue: 11
    StayLength: 10
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 1
  - BodyText: Oh! Anyway... Time to give the library another visit!
    dialogueSpeaker: 1
    SecondsDelayUntilNextDialogue: 5
    StayLength: 5
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 2
  AlwaysAppear: 0
  chanceToAppear: 1
  requiredScenesCompleted:
  - FINAL Parlour Room
  requiredScenesNotCompleted:
  - Exibit 2 Wing 2
  - Wing 3 - Bedroom Greybox
  - Exhibit 1 Wing 2 - Library
  - KitchenWing1
  requiredCollectables: 
  requiredCollectablesUncollected: 
  RequireSpecificHat: 0
  requiredHat: 0
  useOldAudioSystem: 0
  audioEventReference:
    Guid:
      Data1: 1538099910
      Data2: 1112129606
      Data3: 1701490616
      Data4: -1214306549
    Path: event:/Voicelines/VLLobbyNightTwo
  AudioParameterName: VLLobbyNightTwo
  Text: 
  stayLength: 0
  whichLine: 0
  thisLevel: 1
--- !u!114 &5677855763410897439
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7148221544204128209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8fcdce510928fb4ab2354602fe37dcf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PADialogueUITrigger
  dialogueText:
  - BodyText: "Welcome, wonderful guests, to the Illustrious Hubert Museum! We\u2019re
      proud to announce the opening of the lower wing of our Kitchen Exhibit, The
      Pantry! Come check out Hubert\u2019s tea set, a prized artifact from the central
      region of Kyoto, passed down from his dear mother. The exhibit is now free
      to explore, we hope you love it as much as we do! But not enough to take something,
      yeah? This has been a prerecorded message."
    dialogueSpeaker: 0
    SecondsDelayUntilNextDialogue: 13
    StayLength: 13
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 0
  - BodyText: Well, fan my brow! How nice of them to plan my next heist for me!
    dialogueSpeaker: 1
    SecondsDelayUntilNextDialogue: 6
    StayLength: 6
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 1
  AlwaysAppear: 0
  chanceToAppear: 1
  requiredScenesCompleted:
  - FINAL Parlour Room
  - Exhibit 1 Wing 2 - Library
  requiredScenesNotCompleted:
  - Wing 3 - Bedroom Greybox
  - Exibit 2 Wing 2
  - KitchenWing1
  requiredCollectables: 
  requiredCollectablesUncollected: 
  RequireSpecificHat: 0
  requiredHat: 0
  useOldAudioSystem: 0
  audioEventReference:
    Guid:
      Data1: 1309526621
      Data2: 1171642378
      Data3: -998630465
      Data4: 2059124198
    Path: event:/Voicelines/VLLobbyNightThree
  AudioParameterName: VLLobbyNightThree
  Text: 
  stayLength: 0
  whichLine: 0
  thisLevel: 1
--- !u!114 &6375612502822045977
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7148221544204128209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d8fcdce510928fb4ab2354602fe37dcf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PADialogueUITrigger
  dialogueText:
  - BodyText: "Welcome, wonderful guests, to the Illustrious Hubert Museum! We\u2019re
      proud to announce the opening of the upper wing of our Kitchen Exhibit, The
      Canteen! Take a good look at this wing\u2019s artifact, Hubert\u2019s precious
      family Skillet. Like, take a GOOD look, cuz it\u2019s probably not gonna last
      long, haha! Ha\u2026"
    dialogueSpeaker: 0
    SecondsDelayUntilNextDialogue: 15
    StayLength: 15
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 0
  - BodyText: Anywayyy, come back tomorrow for the grand opening of our final and
      GREATEST exhibit! As always, this has been a prerecorded message.
    dialogueSpeaker: 0
    SecondsDelayUntilNextDialogue: 6
    StayLength: 6
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 1
  - BodyText: "3 down, 2 to go. The hour of knavery is upon us\u2026   "
    dialogueSpeaker: 1
    SecondsDelayUntilNextDialogue: 4
    StayLength: 4
    overrideTextData: 0
    overrideAudioEventReference:
      Guid:
        Data1: 0
        Data2: 0
        Data3: 0
        Data4: 0
      Path: 
    AudioParameterName: 
    overrideAudioLine: 0
    audioLine: 2
  AlwaysAppear: 0
  chanceToAppear: 1
  requiredScenesCompleted:
  - FINAL Parlour Room
  - Exhibit 1 Wing 2 - Library
  - KitchenWing1
  requiredScenesNotCompleted:
  - Exibit 2 Wing 2
  - Wing 3 - Bedroom Greybox
  requiredCollectables: 
  requiredCollectablesUncollected: 
  RequireSpecificHat: 0
  requiredHat: 0
  useOldAudioSystem: 0
  audioEventReference:
    Guid:
      Data1: 1683082373
      Data2: 1322897106
      Data3: -2044732529
      Data4: 1547985544
    Path: event:/Voicelines/VLLobbyNightFour
  AudioParameterName: VLLobbyNightFour
